{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1.php" },
    { "src": "/auth/(.*)", "dest": "/auth/$1.php" },
    { "src": "/dashboard/(.*)", "dest": "/dashboard/$1.php" },
    { "src": "/", "dest": "/index.php" }
  ]
}
